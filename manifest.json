{
  "manifest_version": 3,
  "name": "ScreenShield — Sensitive-Info Redaction Mirror",
  "version": "1.0.0",
  "description": "Scans your shared screen for emails, phones, cards, API keys and passwords, then pixelates them in a share-safe mirror. Local OCR, no uploads.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Open ScreenShield",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}